{
  "name": "@worldmonitor/core-types",
  "version": "0.1.0",
  "description": "Shared TypeScript type definitions for the WorldMonitor ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --tsconfig tsconfig.build.json && cp src/globe-gl.d.ts dist/globe-gl.d.ts && node scripts/inject-reference.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ditto190/worldmonitor-dashboard-app.git",
    "directory": "packages/core-types"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "license": "AGPL-3.0-or-later"
}
